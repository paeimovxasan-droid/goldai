# GoldAI Ultra — xavfsiz namuna. Bu faylni .env nomiga nusxalang.
# API kalitlarini GitHub/chatga yozmang; tarqalgan kalitlarni darhol revoke qiling.

# ─── ForexClub / Libertex MT5 ─────────────────────────────────
# Libertex kabinetidagi MT5 hisobidan oling (web-login paroli emas).
MT5_LOGIN=12345678
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=ForexClub-MT5 Demo Server
# terminal64.exe yo'li ixtiyoriy. Bo'sh qoldirilsa ochiq MT5 topiladi.
MT5_PATH=
MT5_TIMEOUT_MS=60000
MT5_FALLBACK_SERVERS=ForexClub-MT5 Demo Server,ForexClub-MT5 Real Server
MT5_MAGIC_NUMBER=999001
BROKER=ForexClub

# live = MT5 ga order yuboradi; paper = real order yubormaydi; auto = balans < $5 bo'lsa paper
# Avval Demo Server + live rejimida tekshiring.
TRADING_MODE=paper

# ─── AI failover (kamida bittasi) ─────────────────────────────
# Tartibda birinchi provider quota/auth/network xatosida keyingisiga o'tiladi.
AI_PROVIDER_ORDER=deepseek,gemini,openai
AI_TIMEOUT_SECONDS=20
AI_PROVIDER_COOLDOWN_SECONDS=300
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Faqat OpenAI-compatible gateway ishlatsangiz o'zgartiring.
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Telegram (ixtiyoriy) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Binance fallback (ixtiyoriy, MT5 asosiy) ─────────────────
ENABLE_BINANCE=false
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true

# ─── Database (ixtiyoriy; ulanish bo'lmasa memory mode) ───────
DB_URL=postgresql://ultra:ultra_secure_2025@localhost:5432/goldai_ultra
REDIS_URL=redis://localhost:6379
API_PORT=8000
